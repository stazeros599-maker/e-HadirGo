# Copy to .env and adjust. Docker Compose reads this file automatically.

# ---- Database ---------------------------------------------------------------
# For docker compose the host is "db"; for a local install use 127.0.0.1.
DB_HOST=db
DB_PORT=3306
DB_NAME=ehadirgo
DB_USER=ehadirgo
DB_PASS=ehadirgo
# Root password for the Docker MySQL container only.
DB_ROOT_PASS=rootpass

# The database layer also accepts a single URL instead of the fields above:
# DATABASE_URL=mysql://ehadirgo:ehadirgo@db:3306/ehadirgo

# Set to 1 when the server requires TLS (managed MySQL).
MYSQL_SSL=0

# ---- Application ------------------------------------------------------------
# 1 = show the OTP and password-reset link on screen. Never in production.
APP_DEBUG=1
# HMAC key for Telegram link tokens. Generate: openssl rand -hex 32
APP_SECRET=dev-only-change-me

# ---- Docker bootstrap -------------------------------------------------------
# Apply schema.mysql.sql on first boot.
RUN_MIGRATIONS=1
# Load the demo roster (db/seed.php).
RUN_SEED=1

# ---- Telegram (optional) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=eHadirGo_bot
TELEGRAM_WEBHOOK_SECRET=

# ---- E-mail (optional; falls back to mail()) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@sabah.gov.my
MAIL_FROM_NAME=e-HadirGo
